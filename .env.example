# Get a key at https://console.anthropic.com (Settings -> API Keys)
# This is a paid API - each "Analyse" click costs a small amount because
# it uses Claude with web search to research the book. Budget a few cents
# per book.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional - improves book metadata lookup reliability and quota.
GOOGLE_BOOKS_API_KEY=

# Required for stable login sessions across restarts and deployments.
SESSION_SECRET=replace-with-a-long-random-secret

# Required in production for persistent account data. Use your hosted PostgreSQL
# connection string (for example, Supabase). Local development can omit this and
# use JSON files under data/ instead.
DATABASE_URL=

# Optional - add these when enabling Stripe subscriptions.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Optional locally. Without these, password reset links are printed to the server
# console for development only. In production both values are required.
RESEND_API_KEY=
RESEND_FROM_EMAIL=KinRead <noreply@example.com>

# Recommended in production. The public URL of your deployment, used to build password
# reset links. Without it the link is built from the request's Host header, which a
# malicious request can spoof to point the reset link at another site.
APP_BASE_URL=https://your-app.onrender.com

# Optional - referral tags for the "Where to get it" links on each analysis.
# Leave blank and the links still work, just untagged and without a commission notice.
AMAZON_ASSOCIATE_TAG=
AMAZON_DOMAIN=www.amazon.com
BOOKSHOP_AFFILIATE_ID=

# Optional - change if you want the server on a different port
PORT=3000
