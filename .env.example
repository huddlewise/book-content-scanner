# Get a key at https://console.anthropic.com (Settings -> API Keys)
# This is a paid API - each "Analyse" click costs a small amount because
# it uses Claude with web search to research the book. Budget a few cents
# per book.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional but recommended once you deploy or share the URL - sets a shared
# family password. Leave unset for local dev; the app is open without it.
APP_PASSWORD=

# Optional - change if you want the server on a different port
PORT=3000
